# TYPE  DATABASE        USER                    ADDRESS                 METHOD

# local superuser
local   all             postgres                                        peer
local   all             all                                             reject

# replication (master accepts streaming from every replica)
{% for replica_host in groups['postgresql-replica'] | default([]) %}
host    replication     {{ postgres_replication_user }}    {{ hostvars[replica_host]['bind_ip'] }}/32    scram-sha-256
{% endfor %}
host    replication     {{ postgres_replication_user }}    {{ hostvars[postgres_master_host]['bind_ip'] }}/32    scram-sha-256

# exporter (runs on the same host via network_mode: host)
host    all             {{ postgres_exporter_user }}       127.0.0.1/32            scram-sha-256

# per-database access
{% for db in postgres_databases %}
{% for user in db.readers | default([]) %}
host    {{ db.name }}   {{ user.username }}   {{ private_network }}   scram-sha-256
{% endfor %}
{% for user in db.writers | default([]) %}
host    {{ db.name }}   {{ user.username }}   {{ private_network }}   scram-sha-256
{% endfor %}
{% if db.owner is defined %}
host    {{ db.name }}   {{ db.owner.username }}   {{ private_network }}   scram-sha-256
{% endif %}
{% endfor %}

# custom entries
{% for entry in pg_hba_entries %}
{{ "%-7s %-15s %-23s %-23s %s" | format(entry.type, entry.database, entry.user, entry.address, entry.method) }}
{% endfor %}

# deny everything else
host    all             all                     0.0.0.0/0               reject
